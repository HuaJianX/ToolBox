<Window x:Class="ToolBox.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ToolBox"
        Title="电脑工具百宝箱"
        Height="800" Width="960"
        MinHeight="640" MinWidth="780"
        WindowStartupLocation="CenterScreen"
        Background="#F2F6FB"
        FontFamily="Microsoft YaHei UI, Microsoft YaHei, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- 所有按钮共用的圆角外观：大、平、没有多余的花样 -->
        <Style x:Key="RoundedButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="24,12" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.70" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 首页那五个大按钮 -->
        <Style x:Key="CategoryButton" TargetType="Button" BasedOn="{StaticResource RoundedButton}">
            <Setter Property="Height" Value="96" />
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="28,0" />
        </Style>

        <!-- 绿色的“开始转换” -->
        <Style x:Key="StartButton" TargetType="Button" BasedOn="{StaticResource RoundedButton}">
            <Setter Property="Background" Value="#2E9E4F" />
            <Setter Property="FontSize" Value="30" />
            <Setter Property="Height" Value="82" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>

        <!-- 白底蓝边的次要按钮 -->
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource RoundedButton}">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#1565C0" />
            <Setter Property="BorderBrush" Value="#1565C0" />
            <Setter Property="BorderThickness" Value="3" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="Padding" Value="28,14" />
        </Style>

        <Style x:Key="CancelButton" TargetType="Button" BasedOn="{StaticResource RoundedButton}">
            <Setter Property="Background" Value="#5B7186" />
            <Setter Property="FontSize" Value="19" />
            <Setter Property="Padding" Value="26,10" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>

        <Style x:Key="BackButton" TargetType="Button" BasedOn="{StaticResource RoundedButton}">
            <Setter Property="Background" Value="#E4EDF7" />
            <Setter Property="Foreground" Value="#1565C0" />
            <Setter Property="FontSize" Value="19" />
            <Setter Property="Padding" Value="20,8" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="RemoveButton" TargetType="Button" BasedOn="{StaticResource RoundedButton}">
            <Setter Property="Background" Value="#ECEFF1" />
            <Setter Property="Foreground" Value="#B0261F" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Padding" Value="14,6" />
        </Style>

        <!-- 格式按钮：选中了变绿边绿底，一眼看得出来 -->
        <Style x:Key="TargetButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#0D2A4A" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="White"
                                BorderBrush="#C5D5E6"
                                BorderThickness="3"
                                CornerRadius="14"
                                Padding="22,16"
                                Margin="0,0,14,14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#1565C0" />
                            </Trigger>
                            <!-- 放最后：选中状态优先于悬停 -->
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#2E9E4F" />
                                <Setter TargetName="Chrome" Property="Background" Value="#E8F6EC" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StepTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="23" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#0D2A4A" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="Foreground" Value="#5B7186" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>

    <Grid>
        <!-- ================= 首页 ================= -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding IsHome, Converter={StaticResource BoolToVisibility}}">
            <StackPanel MaxWidth="780" HorizontalAlignment="Stretch" Margin="40,34,40,34">

                <TextBlock Text="电脑工具百宝箱"
                           FontSize="44" FontWeight="Bold" Foreground="#0D2A4A"
                           HorizontalAlignment="Center" />
                <TextBlock Text="不用联网 · 不要钱 · 不上传文件 · 没有广告"
                           FontSize="19" Foreground="#4A6785"
                           HorizontalAlignment="Center" Margin="0,12,0,0" />
                <TextBlock Text="点一个大按钮 → 选文件 → 点开始，就完事了"
                           FontSize="19" Foreground="#4A6785"
                           HorizontalAlignment="Center" Margin="0,6,0,30" />

                <ItemsControl ItemsSource="{Binding Categories}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource CategoryButton}"
                                    Background="{Binding AccentColor}"
                                    Tag="{Binding}"
                                    Click="Category_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Icon}"
                                               FontFamily="Segoe UI Emoji"
                                               FontSize="44"
                                               Width="76"
                                               VerticalAlignment="Center" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontSize="29" FontWeight="Bold" />
                                        <TextBlock Text="{Binding Subtitle}" FontSize="17" Opacity="0.9" Margin="0,4,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Background="#E4EDF7" CornerRadius="14" Padding="22,18" Margin="0,10,0,0">
                    <TextBlock Text="💡 也可以直接把文件拖进这个窗口，会自动认出该用哪一类。"
                               FontSize="18" Foreground="#33536F" TextWrapping="Wrap" />
                </Border>

                <TextBlock Text="{Binding NoteText}"
                           FontSize="17" Foreground="#B0261F" TextWrapping="Wrap" Margin="0,14,0,0"
                           Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </ScrollViewer>

        <!-- ================= 转换页（三步） ================= -->
        <Grid Visibility="{Binding IsConvert, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 顶栏 -->
            <Border Grid.Row="0" Background="White" BorderBrush="#DCE6F0" BorderThickness="0,0,0,2" Padding="22,14">
                <Grid>
                    <Button Content="← 返回" Style="{StaticResource BackButton}" Click="GoHome_Click" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentCategory.Icon}"
                                   FontFamily="Segoe UI Emoji" FontSize="32"
                                   VerticalAlignment="Center" Margin="0,0,12,0" />
                        <TextBlock Text="{Binding CurrentCategory.Title}"
                                   FontSize="28" FontWeight="Bold" Foreground="#0D2A4A"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="820" HorizontalAlignment="Stretch" Margin="40,24,40,24">

                    <!-- 第 1 步 -->
                    <TextBlock Text="第 1 步 · 把文件放进来" Style="{StaticResource StepTitle}" />

                    <Border Background="White" BorderBrush="#B9CBE0" BorderThickness="3"
                            CornerRadius="16" Padding="26" MinHeight="170">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="把文件拖到这个框里"
                                       FontSize="25" FontWeight="Bold" Foreground="#33536F"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="或者" FontSize="17" Foreground="#6B8299"
                                       HorizontalAlignment="Center" Margin="0,8,0,8" />
                            <Button Content="点这里选文件"
                                    Style="{StaticResource SecondaryButton}"
                                    Click="PickFiles_Click"
                                    HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{Binding FilesSummary}" Style="{StaticResource Hint}" Margin="0,14,0,0" />

                    <ItemsControl ItemsSource="{Binding Files}" Margin="0,12,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#EEF3F8" CornerRadius="10" Padding="16,10" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" ToolTip="{Binding Path}">
                                            <TextBlock Text="{Binding Name}" FontSize="18"
                                                       Foreground="#0D2A4A" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding SizeText}" FontSize="15" Foreground="#6B8299" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="不要这个"
                                                Style="{StaticResource RemoveButton}"
                                                Tag="{Binding}"
                                                Click="RemoveFile_Click"
                                                VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 第 2 步 -->
                    <TextBlock Text="第 2 步 · 要变成什么？" Style="{StaticResource StepTitle}" Margin="0,30,0,12" />
                    <TextBlock Text="带「推荐」的通常最合适，懒得挑就直接点下面的开始。"
                               Style="{StaticResource Hint}" Margin="0,0,0,12" />

                    <ItemsControl ItemsSource="{Binding Targets}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource TargetButton}" Tag="{Binding}" Click="Target_Click">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Label}" FontSize="22" FontWeight="Bold"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Text="推荐" FontSize="16" Foreground="#2E7D32" FontWeight="Bold"
                                                   HorizontalAlignment="Center" Margin="0,6,0,0"
                                                   Visibility="{Binding IsRecommended, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{Binding NoteText}" FontSize="17" Foreground="#B0261F"
                               TextWrapping="Wrap" Margin="0,10,0,0"
                               Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </ScrollViewer>

            <!-- 第 3 步 / 进度 / 完成，都固定在底部，不用去找 -->
            <Border Grid.Row="2" Background="White" BorderBrush="#DCE6F0" BorderThickness="0,2,0,0" Padding="40,20">
                <StackPanel MaxWidth="820" HorizontalAlignment="Stretch">

                    <!-- 还没开始 -->
                    <StackPanel Visibility="{Binding IsReadyToStart, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="第 3 步 · 开始转换" Style="{StaticResource StepTitle}" />
                        <Button Content="开始转换" Style="{StaticResource StartButton}"
                                Click="Start_Click" IsEnabled="{Binding CanStart}" />
                        <TextBlock Text="{Binding OutputHint}" Style="{StaticResource Hint}" Margin="0,12,0,0" />
                    </StackPanel>

                    <!-- 转换中 -->
                    <StackPanel Visibility="{Binding IsConverting, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding StatusText}" FontSize="22" FontWeight="Bold" Foreground="#0D2A4A" />
                        <ProgressBar Height="26" Margin="0,14,0,0" Minimum="0" Maximum="1"
                                     Value="{Binding Progress, Mode=OneWay}"
                                     IsIndeterminate="{Binding IsProgressIndeterminate}" />
                        <Grid Margin="0,10,0,0">
                            <TextBlock Text="{Binding DetailText}" Style="{StaticResource Hint}" />
                            <TextBlock Text="{Binding ProgressText}" FontSize="19" FontWeight="Bold"
                                       Foreground="#33536F" HorizontalAlignment="Right" />
                        </Grid>
                        <Button Content="取消" Style="{StaticResource CancelButton}"
                                Click="Cancel_Click" Margin="0,14,0,0" />
                    </StackPanel>

                    <!-- 完成 -->
                    <StackPanel Visibility="{Binding IsFinished, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="🎉 转换好了" FontSize="30" FontWeight="Bold" Foreground="#2E9E4F" />
                        <TextBlock Text="{Binding FinishedText}" Style="{StaticResource Hint}" Margin="0,10,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Content="打开文件夹" Style="{StaticResource StartButton}"
                                    Height="68" Width="260" Click="OpenFolder_Click" />
                            <Button Content="再转一批" Style="{StaticResource SecondaryButton}"
                                    Padding="26,14" Margin="18,0,0,0" Click="ConvertMore_Click" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
