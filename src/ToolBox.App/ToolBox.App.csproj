<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 带上 Windows 版本号是为了拿到 WinRT 投影：
         内置的 Windows.Data.Pdf 可以离线把 PDF 渲染成图片，不需要装 poppler。
         代价是要求 Windows 10 2004（19041）以上，Win11 更没问题。 -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>

    <AssemblyName>电脑工具百宝箱</AssemblyName>
    <RootNamespace>ToolBox</RootNamespace>
    <Product>电脑工具百宝箱</Product>
    <AssemblyTitle>电脑工具百宝箱</AssemblyTitle>
    <Description>本地离线文件格式转换工具：图片、文档、PDF、音频、视频。无广告，不上传文件。</Description>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <Company>本地工具</Company>
    <Copyright>免费 · 离线 · 无广告</Copyright>

    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <NeutralLanguage>zh-Hans</NeutralLanguage>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF 项目的隐式 using 里没有 System.IO（默认只有 System / Collections.Generic /
         Linq / Threading / Threading.Tasks），而本程序到处都在读写文件，所以补上。 -->
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <!-- 免安装的第三方转换组件（ffmpeg / poppler / pandoc / LibreOffice）放在仓库根目录的 tools 下，
         发布时复制到程序目录的 tools 子目录，实现“离线可用”。
         .downloads 是下载缓存，.ps1 / .md 是说明和脚本，都不该进安装包。

         只设 CopyToPublishDirectory、不设 CopyToOutputDirectory：
         tools 下现在有 1.2 GB（LibreOffice 占大头），往每个 build 输出目录都复制一份
         会白占好几 GB 磁盘；开发和跑自检时，ToolLocator 会从程序目录往上找到仓库根的
         tools，所以不复制也能正常测。

         ExcludeFromSingleFile 很关键：这些是"要被当子进程执行"的 exe，
         必须实实在在躺在磁盘上。不排除的话，单文件发布会把它们塞进 exe 内部，
         运行时 AppContext.BaseDirectory\tools 就是空的，功能全废。 -->
    <None Include="..\..\tools\**\*"
          Exclude="..\..\tools\*.ps1;..\..\tools\**\*.md;..\..\tools\.downloads\**\*"
          Link="tools\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToPublishDirectory="PreserveNewest"
          ExcludeFromSingleFile="true"
          Condition="Exists('..\..\tools')" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Magick.NET-Q16-x64" Version="14.17.1" />
  </ItemGroup>

</Project>
